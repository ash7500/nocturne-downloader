# Environment variables for the downloader backend. Copy to .env and adjust.

# REQUIRED. Shared secret for every download route (sent as the X-Key header).
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_KEY=

# Origin(s) of the Nocturne PWA that may call the API from a browser, comma separated.
# Origin = scheme + host only, e.g. https://yourname.github.io  (no path). "*" is ignored on purpose.
ALLOWED_ORIGINS=

# Port to listen on (Render sets this itself).
PORT=8000

# Where temporary files live inside the container.
DOWNLOADS_DIR=/app/downloads

# --- Optional limits (defaults shown) ---
# Public https URL of this service; used to build the cover link. Render sets RENDER_EXTERNAL_URL automatically.
# PUBLIC_URL=https://your-service.onrender.com
# JOB_TTL_SECONDS=900            # finished/failed jobs and their files are deleted after this
# JOB_MAX_RUNTIME_SECONDS=1800   # unfinished jobs are cancelled and deleted after this
# MAX_CONCURRENT_JOBS=2          # simultaneous yt-dlp/FFmpeg runs
# MAX_ACTIVE_JOBS=4              # more than this returns 429
# MAX_DURATION_SECONDS=1800      # 0 disables the limit
# MAX_FILESIZE_MB=100
# ALLOWED_DOMAINS=               # e.g. archive.org,bandcamp.com (empty = any public site)
